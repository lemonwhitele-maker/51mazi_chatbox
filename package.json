{
  "name": "51mazi",
  "version": "1.0.0",
  "description": "A desktop writing software for novel writers",
  "main": "./out/main/index.js",
  "author": "51mazi",
  "homepage": "https://github.com/lemonwhitele-maker/51mazi_chatbox",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test:book-retrieval": "node scripts/book-retrieval-test.mjs",
    "test:library-api": "node scripts/library-api-config-test.mjs",
    "test:character-avatar": "node scripts/character-avatar-test.mjs && node scripts/avatar-renderer-test.mjs",
    "test:image-api-config": "node scripts/image-api-config-test.mjs",
    "test:knowledge-documents-v2": "node scripts/knowledge-documents-v2-test.mjs",
    "test:harness-codex-contract": "node scripts/harness-codex-contract-test.mjs",
    "test:harness-boundaries": "node scripts/harness-architecture-boundary-test.mjs",
    "test:harness-book-sandbox": "node scripts/harness-book-sandbox-test.mjs",
    "test:harness-book-sandbox-windows": "node scripts/harness-book-sandbox-test.mjs",
    "test:harness-book-runtime": "node scripts/harness-book-runtime-test.mjs",
    "test:harness-document-tools": "node scripts/harness-document-tools-test.mjs && node scripts/harness-document-paths-test.mjs && node scripts/harness-whole-document-test.mjs && node scripts/related-documents-test.mjs",
    "test:harness-document-paths": "node scripts/harness-document-paths-test.mjs",
    "test:harness-document-proposals": "node scripts/harness-document-proposals-test.mjs",
    "test:harness-document-confirmation": "node scripts/harness-document-confirmation-test.mjs",
    "test:harness-document-content": "node scripts/harness-document-content-test.mjs",
    "test:harness-document-recovery": "node scripts/harness-document-confirmation-test.mjs",
    "test:harness-mode-migration": "node scripts/harness-mode-migration-test.mjs",
    "test:harness-four-tool-turn": "node scripts/harness-four-tool-turn-test.mjs",
    "test:four-tools-migration": "node scripts/migrate-four-tools-booklist-test.mjs",
    "test:harness-four-tools": "npm run test:harness-book-runtime && npm run test:harness-book-sandbox && npm run test:harness-document-tools && npm run test:harness-document-proposals && npm run test:harness-document-confirmation && npm run test:harness-document-content && npm run test:harness-mode-migration && npm run test:harness-four-tool-turn && npm run test:four-tools-migration",
    "test:harness-context": "node scripts/harness-context-test.mjs",
    "test:harness-memory": "node scripts/harness-memory-compaction-test.mjs",
    "test:harness-recovery": "node scripts/harness-store-recovery-test.mjs",
    "test:harness-cancellation": "node scripts/harness-cancellation-test.mjs",
    "test:harness-migration": "node scripts/harness-migration-test.mjs",
    "test:harness-chat-ux": "node scripts/harness-chat-ux-test.mjs",
    "test:harness-body-write-ui": "node scripts/harness-body-write-ui-test.mjs && node scripts/edit-proposal-preview-test.mjs && node scripts/proposal-busy-state-test.mjs && node scripts/editor-dirty-state-test.mjs",
    "test:chapter-creation": "node scripts/chapter-creation-contract-test.mjs",
    "test:agent-api": "node scripts/agent-api-runtime-test.mjs",
    "test:cloud-ai-providers": "node scripts/cloud-ai-providers-test.mjs",
    "test:agent-model-selection": "node scripts/agent-model-selection-test.mjs && node scripts/harness-budgets-test.mjs && node scripts/harness-truncation-budget-test.mjs",
    "test:tool-contracts": "node scripts/four-tool-contract-test.mjs",
    "test:tool-protocol": "node scripts/harness-tool-protocol-v2-test.mjs",
    "test:tool-runtime": "npm run test:agent-api && npm run test:agent-model-selection && npm run test:tool-protocol && npm run test:harness-cancellation && npm run test:harness-codex-contract && npm run test:harness-four-tool-turn",
    "test:tool-e2e": "npm run test:harness-document-proposals && npm run test:harness-document-confirmation && npm run test:harness-document-content",
    "test:all-offline": "npm run test:library-api && npm run test:character-avatar && npm run test:image-api-config && npm run test:book-retrieval && npm run test:tool-contracts && npm run test:tool-runtime && npm run test:tool-e2e && npm run test:harness-context && npm run test:harness-memory && npm run test:harness-recovery && npm run test:harness-migration && npm run test:harness-book-runtime && npm run test:harness-book-sandbox && npm run test:harness-document-tools && npm run test:harness-document-proposals && npm run test:harness-document-confirmation && npm run test:harness-document-content && npm run test:harness-mode-migration && npm run test:four-tools-migration && npm run test:harness-boundaries && npm run test:harness-body-write-ui && npm run test:chapter-creation && npm run test:knowledge-documents-v2",
    "migrate:four-tools:books": "node scripts/migrate-four-tools-booklist.mjs",
    "migrate:four-tools:conversations": "node scripts/migrate-four-tools-conversations.mjs",
    "verify:release": "npm run lint && npm run test:all-offline && npm run build",
    "generate:harness-codex-schema": "node scripts/generate-codex-app-server-schema.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release:win": "npm run build && electron-builder --win --publish=always",
    "release:mac": "npm run build && electron-builder --mac --publish=always",
    "release:linux": "npm run build && electron-builder --linux --publish=always",
    "release:all": "npm run build && electron-builder --win --mac --linux --publish=always",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@openai/codex": "0.145.0",
    "@tiptap/core": "^3.7.0",
    "@tiptap/extension-bold": "^3.7.0",
    "@tiptap/extension-highlight": "^3.7.0",
    "@tiptap/extension-italic": "^3.7.0",
    "@tiptap/extension-text-align": "^3.7.0",
    "@tiptap/starter-kit": "^3.7.0",
    "@tiptap/vue-3": "^3.7.0",
    "ajv": "8.17.1",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "element-plus": "^2.11.4",
    "iconv-lite": "^0.6.3",
    "js-yaml": "^4.1.0",
    "lucide-vue-next": "^0.561.0",
    "perfect-freehand": "^1.2.2",
    "pinia": "^3.0.3",
    "relation-graph-vue3": "^2.2.11",
    "roughjs": "^4.6.6",
    "sortablejs": "^1.15.6",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.1",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^6.4.0",
    "vue": "^3.5.22"
  }
}
